generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String              @id @default(cuid())
  username                String              @unique
  normalizedUsername      String?             @unique
  accountId               String?             @unique
  displayName             String
  passwordHash            String
  role                    String              @default("OPERATOR")
  status                  String              @default("ACTIVE")
  lastLoginAt             DateTime?
  lastLocalLoginAt        DateTime?
  issuedAt                DateTime?
  expiresAt               DateTime?
  activatedAt             DateTime?
  activationIssuer        String?
  activationSignature     String?
  activationSchemaVersion Int?
  authorizationVersion    Int                 @default(1)
  sessionVersion          Int                 @default(1)
  lastSeenClockAt         DateTime?
  authProvider            String?
  centralUserId           String?             @unique
  teamId                  String?
  centralRole             String?
  centralStatus           String?
  lastCentralVerifiedAt   DateTime?
  offlineValidUntil       DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  manualReviews           ManualReview[]
  operationLogs           OperationLog[]
  auditBatches            AuditBatch[]
  importRecords           ImportRecord[]
  usageSummaries          LocalUsageSummary[]
  localSessions           LocalAuthSession[]

  @@index([role, status])
  @@index([teamId, centralStatus])
  @@index([accountId, status])
  @@map("users")
}

model StoreTopicRule {
  id                  String            @id @default(cuid())
  commercePlatform    String
  storeName           String
  normalizedStoreName String
  expectedTopic       String
  enabled             Boolean           @default(true)
  deletedAt           DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  topicEntries        StoreTopicEntry[]

  @@unique([commercePlatform, normalizedStoreName])
  @@index([commercePlatform, enabled, deletedAt])
  @@index([updatedAt])
  @@map("store_topic_rules")
}

model StoreTopicEntry {
  id               String         @id @default(cuid())
  storeTopicRuleId String
  topic            String
  normalizedTopic  String
  topicType        String         @default("ACCEPTED")
  sortOrder        Int            @default(0)
  enabled          Boolean        @default(true)
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  storeTopicRule   StoreTopicRule @relation(fields: [storeTopicRuleId], references: [id], onDelete: Cascade)

  @@unique([storeTopicRuleId, normalizedTopic])
  @@index([storeTopicRuleId, topicType, enabled, deletedAt, sortOrder])
  @@map("store_topic_entries")
}

model LocalAuthSession {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  sessionVersion Int
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("local_auth_sessions")
}

model LocalLoginThrottle {
  id                 String    @id @default(cuid())
  normalizedUsername String    @unique
  failureCount       Int       @default(0)
  blockedUntil       DateTime?
  lastFailureAt      DateTime?
  updatedAt          DateTime  @updatedAt

  @@index([blockedUntil])
  @@map("local_login_throttles")
}

model AccountCodeUse {
  id         String   @id @default(cuid())
  codeDigest String   @unique
  codeKind   String
  accountId  String
  usedAt     DateTime @default(now())

  @@index([accountId, codeKind, usedAt])
  @@map("account_code_uses")
}

model LocalDevice {
  id             String              @id
  deviceId       String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  usageSummaries LocalUsageSummary[]

  @@map("local_devices")
}

model LocalUsageSummary {
  id                     String      @id @default(cuid())
  date                   String
  localUserId            String
  deviceId               String
  softwareVersion        String
  ruleVersion            String
  taskCount              Int         @default(0)
  auditCount             Int         @default(0)
  passedCount            Int         @default(0)
  failedCount            Int         @default(0)
  reviewCount            Int         @default(0)
  nonSensitiveErrorCount Int         @default(0)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  user                   User        @relation(fields: [localUserId], references: [id], onDelete: Cascade)
  device                 LocalDevice @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@unique([date, localUserId, deviceId])
  @@index([localUserId, date])
  @@index([deviceId, date])
  @@map("local_usage_summaries")
}

model Product {
  id               String            @id @default(cuid())
  publishedKey     String?           @unique
  ruleSource       String            @default("LOCAL_DRAFT")
  code             String?           @unique
  name             String
  brandName        String
  seriesName       String?
  category         String?
  contentDirection String?
  status           String            @default("ACTIVE")
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  aliases          ProductAlias[]
  campaigns        Campaign[]
  campaignLinks    CampaignProduct[]
  topicRules       TopicRule[]
  auditTasks       AuditTask[]
  auditBatches     AuditBatch[]
  noteProducts     NoteProduct[]

  @@index([name])
  @@index([brandName, status])
  @@map("products")
}

model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  alias     String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, alias])
  @@index([alias])
  @@map("product_aliases")
}

model Campaign {
  id                        String            @id @default(cuid())
  publishedKey              String?           @unique
  ruleSource                String            @default("LOCAL_DRAFT")
  productId                 String?
  name                      String
  contentChannel            String            @default("XIAOHONGSHU")
  month                     String
  year                      Int?
  startDate                 DateTime
  endDate                   DateTime
  minImageCount             Int               @default(2)
  productImageRequired      Boolean           @default(false)
  firstImageRequirement     String?
  prohibitedImageGuidance   String?
  bodyRequired              Boolean           @default(true)
  minBodyLength             Int               @default(1)
  publicRequired            Boolean           @default(false)
  retentionDays             Int               @default(0)
  rewardDescription         String?
  visualReviewGuidance      String?
  customerRegistrationNotes String?
  clickableTopicRequired    Boolean           @default(true)
  ruleVersion               Int               @default(1)
  status                    String            @default("ACTIVE")
  deletedAt                 DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  product                   Product?          @relation(fields: [productId], references: [id])
  products                  CampaignProduct[]
  topicRules                TopicRule[]
  auditTasks                AuditTask[]
  auditBatches              AuditBatch[]

  @@unique([name, month])
  @@index([contentChannel, month, status])
  @@index([productId, status])
  @@map("campaigns")
}

model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  productId  String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([productId, campaignId])
  @@map("campaign_products")
}

model TopicRule {
  id                String    @id @default(cuid())
  publishedKey      String?   @unique
  ruleSource        String    @default("LOCAL_DRAFT")
  scope             String    @default("CAMPAIGN")
  campaignId        String?
  productId         String?
  brandName         String?
  contentChannel    String    @default("XIAOHONGSHU")
  ruleType          String
  topicCategory     String    @default("GENERAL")
  applicableStage   String?
  milkType          String?
  topic             String
  exactMatch        Boolean   @default(true)
  clickableRequired Boolean   @default(false)
  caseSensitive     Boolean   @default(false)
  minCount          Int       @default(1)
  sortOrder         Int       @default(0)
  version           Int       @default(1)
  status            String    @default("ACTIVE")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product           Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([contentChannel, scope, status])
  @@index([brandName, status, sortOrder])
  @@index([campaignId, status, sortOrder])
  @@index([productId, status])
  @@index([campaignId, applicableStage, status])
  @@map("topic_rules")
}

model AuditTask {
  id                  String             @id @default(cuid())
  batchId             String?
  importRecordId      String?
  url                 String
  originalInput       String?
  normalizedUrl       String
  productId           String
  campaignId          String
  productStage        String?
  milkType            String?
  source              String             @default("MANUAL")
  status              String             @default("PENDING")
  queueOrder          Int                @default(0)
  replacesResultId    String?
  attempts            Int                @default(0)
  failureCode         String?
  failureMessage      String?
  finalUrl            String?
  pageTitle           String?
  pageType            String?
  redirectChain       String             @default("[]")
  failureEvidence     String?
  notes               String?
  platform            String?
  channel             String?
  commercePlatform    String?
  storeName           String?
  storeTopicRuleId    String?
  matchedStoreName    String?
  expectedStoreTopic  String?
  expectedStoreTopics String             @default("[]")
  requiredStoreTopics String             @default("[]")
  storeMappingStatus  String?
  orderNumber         String?
  softwareVersion     String?
  rulePackageVersion  String?
  createdBy           String?
  startedAt           DateTime?
  finishedAt          DateTime?
  nextRunAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  batch               AuditBatch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  importRecord        ImportRecord?      @relation(fields: [importRecordId], references: [id], onDelete: SetNull)
  product             Product            @relation(fields: [productId], references: [id])
  campaign            Campaign           @relation(fields: [campaignId], references: [id])
  extractions         ExtractionRecord[]
  auditResults        AuditResult[]

  @@index([status, createdAt])
  @@index([batchId, status, queueOrder])
  @@index([importRecordId])
  @@index([campaignId, status])
  @@index([normalizedUrl])
  @@index([replacesResultId])
  @@index([platform])
  @@index([channel])
  @@index([commercePlatform])
  @@index([storeTopicRuleId])
  @@index([orderNumber])
  @@map("audit_tasks")
}

model AuditBatch {
  id               String        @id @default(cuid())
  name             String?
  importRecordId   String?
  productId        String?
  campaignId       String?
  productStage     String?
  source           String        @default("MANUAL")
  channel          String?
  queueOrder       Int           @default(0)
  status           String        @default("QUEUED")
  totalCount       Int           @default(0)
  intervalMs       Int           @default(5000)
  currentTaskId    String?
  lastErrorCode    String?
  lastErrorMessage String?
  createdBy        String?
  startedAt        DateTime?
  finishedAt       DateTime?
  pausedAt         DateTime?
  cancelledAt      DateTime?
  clearedAt        DateTime?
  clearedBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  product          Product?      @relation(fields: [productId], references: [id])
  campaign         Campaign?     @relation(fields: [campaignId], references: [id])
  creator          User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  importRecord     ImportRecord? @relation(fields: [importRecordId], references: [id], onDelete: SetNull)
  tasks            AuditTask[]

  @@index([status, createdAt])
  @@index([createdBy, createdAt])
  @@index([clearedAt, createdAt])
  @@index([importRecordId])
  @@index([channel, status])
  @@index([status, queueOrder, createdAt])
  @@map("audit_batches")
}

model AutomationSession {
  id            String    @id
  platform      String    @unique
  status        String    @default("UNKNOWN")
  profilePath   String
  lastCheckedAt DateTime?
  lastLoginAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("automation_sessions")
}

model NoteRecord {
  id                    String             @id @default(cuid())
  contentChannel        String?
  platformNoteId        String?
  url                   String             @unique
  finalUrl              String?
  title                 String?
  body                  String?
  authorName            String?
  publishedAt           DateTime?
  pageStatus            String             @default("NORMAL")
  isPublic              Boolean?
  noteType              String             @default("UNKNOWN")
  imageExtractionStatus String             @default("NOT_CHECKED")
  imageCount            Int                @default(0)
  imageUrls             String             @default("[]")
  firstCapturedAt       DateTime           @default(now())
  lastCapturedAt        DateTime           @default(now())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  topics                NoteTopic[]
  extractions           ExtractionRecord[]
  noteProducts          NoteProduct[]
  auditResults          AuditResult[]

  @@unique([contentChannel, platformNoteId])
  @@index([contentChannel, pageStatus])
  @@map("note_records")
}

model NoteProduct {
  id         String     @id @default(cuid())
  noteId     String
  productId  String
  isPrimary  Boolean    @default(false)
  confidence Float?
  createdAt  DateTime   @default(now())
  note       NoteRecord @relation(fields: [noteId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([noteId, productId])
  @@index([productId])
  @@map("note_products")
}

model NoteTopic {
  id             String     @id @default(cuid())
  noteId         String
  displayText    String
  normalizedText String
  isLinkElement  Boolean    @default(false)
  hasHref        Boolean    @default(false)
  href           String?
  textColor      String?
  styleFeature   Boolean    @default(false)
  isClickable    Boolean    @default(false)
  domPath        String?
  source         String?
  createdAt      DateTime   @default(now())
  note           NoteRecord @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, normalizedText])
  @@map("note_topics")
}

model ExtractionRecord {
  id             String     @id @default(cuid())
  auditTaskId    String?
  noteId         String
  adapterName    String
  adapterVersion String
  pageStatus     String
  rawData        String
  extractedAt    DateTime   @default(now())
  createdAt      DateTime   @default(now())
  task           AuditTask? @relation(fields: [auditTaskId], references: [id])
  note           NoteRecord @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([auditTaskId, extractedAt])
  @@index([noteId, extractedAt])
  @@map("extraction_records")
}

model AuditResult {
  id                         String         @id @default(cuid())
  auditTaskId                String
  originTaskId               String?
  resultSlotOrder            Int            @default(0)
  resultSlotCreatedAt        DateTime?
  supersededAt               DateTime?
  supersededByResultId       String?
  noteId                     String
  ruleVersion                Int
  softwareVersion            String         @default("unknown")
  rulePackageVersion         String?
  ruleSnapshot               String
  pageStatus                 String
  bodyStatus                 String
  effectiveBodyLength        Int            @default(0)
  bodyCompliant              Boolean        @default(true)
  noteType                   String         @default("UNKNOWN")
  imageExtractionStatus      String         @default("NOT_CHECKED")
  imageStatus                String         @default("NOT_REQUIRED")
  imageCount                 Int
  imageCompliant             Boolean
  topicsCompliant            Boolean
  clickableCompliant         Boolean
  storeTopicStatus           String         @default("NOT_CHECKED")
  expectedStoreTopic         String?
  matchedStoreTopic          String?
  expectedStoreTopics        String         @default("[]")
  requiredStoreTopics        String         @default("[]")
  matchedStoreTopics         String         @default("[]")
  matchedRequiredStoreTopics String         @default("[]")
  storeTopicFailureReason    String?
  missingTopics              String         @default("[]")
  forbiddenTopics            String         @default("[]")
  autoStatus                 String
  publicStatus               String         @default("NOT_REQUIRED")
  retentionStatus            String         @default("NOT_REQUIRED")
  retentionDueAt             DateTime?
  visualReviewStatus         String         @default("NOT_REQUIRED")
  visualReviewDetails        String         @default("{}")
  failureReasons             String         @default("[]")
  aiStatus                   String         @default("DISABLED")
  aiRelevance                String?
  aiReason                   String?
  auditedAt                  DateTime       @default(now())
  createdAt                  DateTime       @default(now())
  task                       AuditTask      @relation(fields: [auditTaskId], references: [id])
  note                       NoteRecord     @relation(fields: [noteId], references: [id])
  ruleResults                RuleResult[]
  manualReviews              ManualReview[]

  @@index([autoStatus, auditedAt])
  @@index([imageStatus, auditedAt])
  @@index([auditTaskId, auditedAt])
  @@index([noteId])
  @@index([originTaskId])
  @@index([supersededByResultId])
  @@index([supersededAt, resultSlotCreatedAt, resultSlotOrder])
  @@map("audit_results")
}

model RuleResult {
  id            String      @id @default(cuid())
  auditResultId String
  ruleKey       String
  ruleName      String
  expectedValue String
  actualValue   String
  passed        Boolean
  failureReason String?
  evidence      String
  createdAt     DateTime    @default(now())
  auditResult   AuditResult @relation(fields: [auditResultId], references: [id], onDelete: Cascade)

  @@index([auditResultId, passed])
  @@map("rule_results")
}

model ManualReview {
  id            String      @id @default(cuid())
  auditResultId String
  reviewerId    String
  result        String
  comment       String?
  createdAt     DateTime    @default(now())
  auditResult   AuditResult @relation(fields: [auditResultId], references: [id])
  reviewer      User        @relation(fields: [reviewerId], references: [id])

  @@index([auditResultId, createdAt])
  @@index([reviewerId])
  @@map("manual_reviews")
}

model OperationLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   String?  @default("{}")
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("operation_logs")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model RuleStageGroup {
  key              String   @id
  label            String
  canonicalStages  String
  bodyTerms        String
  requireBodyStage Boolean  @default(false)
  requiredTopic    String
  sortOrder        Int      @default(0)
  status           String   @default("ACTIVE")
  ruleVersion      String
  ruleSource       String   @default("LOCAL_DRAFT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, sortOrder])
  @@map("rule_stage_groups")
}

model RuleSyncState {
  id                    String    @id @default("active")
  currentVersion        String
  latestVersion         String?
  schemaVersion         Int       @default(1)
  source                String    @default("BUILTIN")
  status                String    @default("USING_BUILTIN")
  countsJson            String    @default("{}")
  manifestJson          String?
  previousVersion       String?
  templateVersion       String?
  templateSchemaVersion Int?
  templateConfigJson    String?
  lastCheckedAt         DateTime?
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("rule_sync_states")
}

model RuleSyncHistory {
  id            String    @id @default(cuid())
  ruleVersion   String?
  schemaVersion Int?
  source        String
  status        String
  errorCode     String?
  message       String?
  detailsJson   String    @default("{}")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("rule_sync_history")
}

model RulePackageBackup {
  id            String    @id @default(cuid())
  ruleVersion   String
  schemaVersion Int
  source        String
  sha256        String
  payloadJson   String
  createdAt     DateTime  @default(now())
  restoredAt    DateTime?

  @@index([createdAt])
  @@map("rule_package_backups")
}

model ImportRecord {
  id                  String       @id @default(cuid())
  fileName            String
  importType          String
  totalCount          Int
  validCount          Int
  invalidCount        Int
  skippedCount        Int          @default(0)
  status              String
  summary             String
  channelDistribution String       @default("{}")
  createdBy           String?
  createdAt           DateTime     @default(now())
  creator             User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  auditBatches        AuditBatch[]
  auditTasks          AuditTask[]

  @@index([importType, createdAt])
  @@map("import_records")
}
