{
  "name": "veridia",
  "productName": "VERIDIA",
  "version": "1.0.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jd-pages/veridia.git"
  },
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && node scripts/assert-prisma-generated.mjs && next build",
    "desktop:prepare": "prisma generate && node scripts/assert-prisma-generated.mjs && node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run build && npm run desktop:prepare && node scripts/build-desktop.mjs",
    "desktop:dir": "npm run build && npm run desktop:prepare && node scripts/build-desktop.mjs --dir",
    "desktop:dev": "npm run build && npm run desktop:prepare && electron .",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tests/e2e/setup-database.ts && playwright test",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:tag": "node scripts/create-release-tag.mjs",
    "rules:export-default": "tsx scripts/export-default-rules.ts",
    "rules:publish": "tsx scripts/publish-rules.ts",
    "db:generate": "prisma generate",
    "prisma:assert": "node scripts/assert-prisma-generated.mjs",
    "prisma:assert-packaged": "node scripts/assert-packaged-prisma.mjs",
    "db:ensure": "tsx scripts/ensure-sqlite-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:init-empty": "prisma migrate reset --force --skip-seed --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:postgres-schema": "tsx scripts/generate-postgres-schema.ts",
    "excel:template": "tsx scripts/generate-excel-template.ts",
    "setup": "prisma generate && npm run db:ensure && prisma migrate deploy && npm run db:seed && npm run excel:template && npm run db:postgres-schema"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@prisma/client": "6.13.0",
    "antd": "^5.26.7",
    "bcryptjs": "^3.0.2",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.7.0",
    "exceljs": "^4.4.0",
    "jose": "^6.0.12",
    "jszip": "^3.10.1",
    "next": "^16.2.12",
    "playwright": "^1.62.0",
    "pm2": "7.0.3",
    "prisma": "6.13.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "build": {
    "appId": "com.veridia.contentgovernance",
    "productName": "VERIDIA",
    "artifactName": "VERIDIA-Setup-${version}.${ext}",
    "directories": {
      "output": "dist-installer"
    },
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack.mjs",
    "asar": false,
    "files": [
      "desktop/**/*",
      ".next/standalone/**/*",
      "assets/veridia.ico",
      "prisma/schema.prisma",
      "prisma/migrations/**/*",
      "node_modules/prisma/**/*",
      "node_modules/@prisma/**/*",
      "node_modules/.prisma/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-runtime/ms-playwright",
        "to": "ms-playwright"
      },
      {
        "from": "desktop-runtime/node",
        "to": "node"
      }
    ],
    "win": {
      "icon": "assets/veridia.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.VERIDIA_UPDATE_URL}"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VERIDIA",
      "uninstallDisplayName": "VERIDIA",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "desktop/installer.nsh"
    }
  }
}
