DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-this-to-a-long-random-string"
AUTH_COOKIE_SECURE="false"
EXTENSION_TOKEN="local-extension-demo-token"
NEXT_PUBLIC_APP_URL="http://localhost:3100"
PLAYWRIGHT_BROWSER_CHANNEL=""
AUTOMATION_INTERVAL_MS="5000"
AUTOMATION_PAGE_TIMEOUT_MS="30000"

# 独立公开规则仓库，格式 owner/repository。未配置时始终使用本地内置规则。
VERIDIA_RULES_REPOSITORY=
# 客户端只配置 Ed25519 公钥；不得配置 GitHub Token 或签名私钥。
VERIDIA_RULES_PUBLIC_KEY_PATH=rules/public-key.pem
